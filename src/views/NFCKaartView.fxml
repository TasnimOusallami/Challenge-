<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.NFCKaartController" 
            stylesheets="@../styles/style.css" prefWidth="1000" prefHeight="600">
    
    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="🏠" onAction="#handleHome" styleClass="icon-button"/>
            <Button text="←" onAction="#handleBack" styleClass="icon-button"/>
        </HBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-background: linear-gradient(to bottom, #2b8a9e, #5eb3d1); -fx-padding: 50;">
            <Label text="Bestel NFC-kaart" style="-fx-font-size: 32px; -fx-text-fill: black; -fx-font-weight: bold;"/>
            
            <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 10;">
                <Label text="💳" style="-fx-font-size: 80px;"/>
                <Label text="Bestel je persoonlijke NFC-kaart" style="-fx-font-size: 18px; -fx-text-fill: #666;"/>
                <Label text="Met deze kaart kun je snel en eenvoudig je CV delen" 
                       style="-fx-font-size: 14px; -fx-text-fill: #999; -fx-wrap-text: true; -fx-max-width: 400; -fx-text-alignment: center;"/>
                
                <Button text="Bestel" onAction="#handleBestel" styleClass="primary-button" 
                        style="-fx-min-width: 200; -fx-pref-height: 50; -fx-font-size: 18px;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
