<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.BedrijfDetailController" 
            stylesheets="@../styles/style.css" prefWidth="1000" prefHeight="600">
    
    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="🏠" onAction="#handleHome" styleClass="icon-button"/>
            <Button text="←" onAction="#handleBack" styleClass="icon-button"/>
            <Button text="→" styleClass="icon-button"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>
    
    <left>
        <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #f0f0f0; -fx-pref-width: 450;">
            <Label fx:id="bedrijfNaamLabel" text="Microsoft" style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="15">
                    <Label fx:id="bedrijfDescriptionLabel" wrapText="true" 
                           style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    
                    <Label text="Vacatures" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <FlowPane fx:id="vacaturesPane" hgap="10" vgap="10"/>
                    
                    <Button text="Solliciteer" styleClass="primary-button" 
                            style="-fx-min-width: 150; -fx-pref-height: 40; -fx-margin-top: 20;"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    
    <center>
        <Pane style="-fx-background: linear-gradient(to bottom, #2b8a9e, #5eb3d1);"/>
    </center>
</BorderPane>
