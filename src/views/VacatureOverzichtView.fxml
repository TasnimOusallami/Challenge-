<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.VacatureOverzichtController" 
            stylesheets="@../styles/style.css" prefWidth="1000" prefHeight="600">
    
    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="🏠" onAction="#handleHome" styleClass="icon-button"/>
            <Button text="←" onAction="#handleBack" styleClass="icon-button"/>
            <Button text="→" styleClass="icon-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="👤" onAction="#handleProfiel" styleClass="icon-button"/>
            <Button text="Uitloggen" onAction="#handleLogout" styleClass="logout-button"/>
        </HBox>
    </top>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 40; -fx-background-color: #f0f0f0;">
            <Label text="Vacature Overzicht" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Dubbelklik op een vacature om sollicitanten te bekijken" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
            
            <ListView fx:id="vacatureListView" style="-fx-background-color: transparent;" 
                      VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
